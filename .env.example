# Copy this file to .env and fill in your values.
# Never commit .env to GitHub.

SENDER_EMAIL=your.email@gmail.com
APP_PASSWORD=xxxx xxxx xxxx xxxx

CV_PATH=./CV.pdf
PROFESSOR_LIST_PATH=./examples/professors.example.csv

# Optional email identity (used in the message body)
APPLICANT_NAME=Your Full Name
APPLICANT_DEGREE=BSCS, Your University, CGPA x.xx/4.0
APPLICANT_PHONE=+00 000 000-0000
APPLICANT_BACKGROUND=a Computer Science graduate with software engineering experience

# Sending pace
EMAILS_PER_BATCH=20
DELAY_BETWEEN_EMAILS_MS=6000
